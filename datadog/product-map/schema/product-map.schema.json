{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis.local/datadog/product-map.schema.json",
  "title": "Datadog investor product map",
  "type": "object",
  "required": [
    "categories",
    "maturity",
    "position",
    "momentum",
    "evidenceConfidence",
    "entityTypes",
    "relatedEntities",
    "platformEnablers",
    "boundaryConventions",
    "sources",
    "productSources",
    "meta"
  ],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/category"}
    },
    "relatedEntities": {
      "type": "array",
      "items": {"$ref": "#/$defs/relatedEntity"}
    },
    "platformEnablers": {
      "type": "array",
      "items": {"$ref": "#/$defs/platformEnabler"}
    },
    "sources": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "productSources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "url", "quote"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidenceConfidence": {
      "type": "object",
      "required": ["high", "medium", "low"],
      "additionalProperties": {
        "type": "object",
        "required": ["label", "short", "rationale"]
      }
    },
    "meta": {
      "type": "object",
      "required": ["asOf", "companyReportedProductCount", "auditedSource", "directionalSource"]
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "catName", "gart", "anchor", "suites"],
      "properties": {
        "id": {"enum": ["obs", "sec", "dev", "pa"]},
        "anchor": {
          "type": "object",
          "required": ["val", "scope", "lab"],
          "properties": {
            "scope": {"const": "category"}
          }
        },
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/suite"}
        }
      }
    },
    "suite": {
      "type": "object",
      "required": ["name", "products"],
      "properties": {
        "products": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/product"}
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "n",
        "entityType",
        "maturity",
        "position",
        "momentum",
        "moatConviction",
        "moatConvictionRationale",
        "evidenceConfidence",
        "canonicalCategory",
        "suiteMappings",
        "monetization",
        "motion",
        "workloads",
        "moat",
        "dcf",
        "evidence",
        "assessmentEvidence"
      ],
      "properties": {
        "entityType": {
          "enum": ["product", "product_family", "interface", "platform_primitive"]
        },
        "maturity": {"enum": ["scaled", "proven", "validated", "option"]},
        "position": {"enum": ["leader", "strong_challenger", "challenger", "niche", "unproven"]},
        "momentum": {"enum": ["improving", "stable", "watch", "insufficient"]},
        "moatConviction": {"enum": ["strong", "credible", "emerging", "weak"]},
        "moatConvictionRationale": {"type": "string", "minLength": 1},
        "evidenceConfidence": {
          "type": "object",
          "required": ["maturity", "position", "momentum", "moatConviction"],
          "properties": {
            "maturity": {"enum": ["high", "medium", "low"]},
            "position": {"enum": ["high", "medium", "low"]},
            "momentum": {"enum": ["high", "medium", "low"]},
            "moatConviction": {"enum": ["high", "medium", "low"]}
          },
          "additionalProperties": false
        },
        "canonicalCategory": {"enum": ["obs", "sec", "dev", "pa"]},
        "suiteMappings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/suiteMapping"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "assessmentEvidence": {
          "type": "object",
          "required": ["maturity", "position", "momentum", "moatConviction"],
          "additionalProperties": {"$ref": "#/$defs/assessmentEvidence"}
        }
      }
    },
    "suiteMapping": {
      "type": "object",
      "required": ["suite", "validFrom", "validTo", "source"]
    },
    "evidence": {
      "type": "object",
      "required": ["claim", "source", "sourceClass", "scope", "confidence", "asOf"]
    },
    "assessmentEvidence": {
      "type": "object",
      "required": ["rationale", "confidence", "asOf", "sources"],
      "properties": {
        "confidence": {"enum": ["high", "medium", "low"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "locator", "role", "scope"],
            "properties": {
              "label": {"type": "string"},
              "url": {"type": "string"},
              "role": {"enum": ["direct", "supporting", "context", "judgment", "limitation"]},
              "scope": {"type": "string", "minLength": 1},
              "excerptType": {"enum": ["quote", "company_excerpt", "parsed_summary", "note"]},
              "summary": {"type": "string"},
              "caveat": {"type": "string"}
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["label", "publisher", "date", "sourceClass", "access", "url", "hoverText", "hoverType"],
      "properties": {
        "access": {"enum": ["public", "subscriber", "internal"]},
        "url": {"type": ["string", "null"]},
        "hoverType": {"enum": ["quote", "parsed_summary", "note"]}
      }
    },
    "relatedEntity": {
      "type": "object",
      "required": ["id", "name", "entityType", "parent", "description", "moat", "dcf", "asOf"]
    },
    "platformEnabler": {
      "type": "object",
      "required": ["id", "name", "entityType", "tags", "description", "dcf"]
    }
  }
}
